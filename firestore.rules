rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---
    
    // Verifica se o usuário está na coleção 'admin_users' e pega seus dados
    function getAdminUser() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data;
    }

    function isLoggedAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email));
    }

    // Verifica se é Super Admin
    function isSuperAdmin() {
      let user = getAdminUser();
      return user != null && user.role == 'super_admin';
    }

    // Verifica se tem permissão para a propriedade específica
    function hasPropertyAccess(propertyId) {
      let user = getAdminUser();
      return user != null && (user.role == 'super_admin' || user.allowedProperties.hasAny([propertyId]));
    }

    // Reservas legadas podem não ter propertyId. Somente o super admin pode
    // acessá-las até que o imóvel seja definido; reservas modernas continuam
    // respeitando o isolamento por propriedade.
    function hasReservationAccess(data) {
      return ('propertyId' in data && hasPropertyAccess(data.propertyId))
        || (!('propertyId' in data) && isSuperAdmin());
    }

    function isValidDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // O único cadastro público de reserva é o pedido da landing do Flat da Lili.
    // Campos operacionais, financeiros e corporativos nunca podem ser enviados pelo cliente público.
    function isValidPublicBooking() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'guestName', 'guestPhone', 'email', 'propertyId',
          'checkInDate', 'checkoutDate', 'checkInTime', 'checkOutTime',
          'guestCount', 'paymentMethod', 'paymentStatus', 'status',
          'createdAt', 'shortId'
        ])
        && data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 120
        && data.guestPhone is string && data.guestPhone.size() >= 8 && data.guestPhone.size() <= 20
        && data.email is string && data.email.size() <= 254
        && data.propertyId == 'lili'
        && isValidDate(data.checkInDate)
        && isValidDate(data.checkoutDate)
        && data.checkInDate < data.checkoutDate
        && data.status == 'pending'
        && data.paymentMethod == 'pix'
        && data.paymentStatus == 'pending'
        && data.guestCount is int && data.guestCount >= 1 && data.guestCount <= 10
        && data.shortId is string && data.shortId.size() >= 5 && data.shortId.size() <= 12;
    }

    function hasValidCorporateLink(data) {
      return !('billingMode' in data) || data.billingMode == 'reservation'
        ? !data.keys().hasAny(['companyId', 'contractId', 'allocationId'])
        : data.billingMode == 'corporate'
          && data.companyId is string
          && data.contractId is string
          && data.allocationId is string
          && data.propertyId == 'integracao'
          && data.paymentStatus == 'billed'
          && !data.keys().hasAny(['totalAmount', 'depositAmount', 'paymentMethod'])
          && exists(/databases/$(database)/documents/allocations/$(data.allocationId))
          && get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.companyId == data.companyId
          && get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.contractId == data.contractId
          && get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.propertyId == data.propertyId
          && get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.flatNumber == data.flatNumber
          && get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.status == 'active'
          && data.checkInDate >= get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.startDate
          && (!('endDate' in get(/databases/$(database)/documents/allocations/$(data.allocationId)).data)
              || data.checkoutDate <= get(/databases/$(database)/documents/allocations/$(data.allocationId)).data.endDate)
          && exists(/databases/$(database)/documents/contracts/$(data.contractId))
          && get(/databases/$(database)/documents/contracts/$(data.contractId)).data.status == 'active';
    }

    // --- REGRAS ---

    // 1. CONFIGURAÇÕES (Leitura pública, Escrita restrita a qualquer admin)
    match /app_config/{document} {
      allow read: if true;
      allow write: if request.auth != null && getAdminUser() != null;
    }

    // 2. RESERVAS (Multi-Tenant) - COM VALIDAÇÃO ANTI-SPAM
    match /reservations/{document} {
      // Função para validar dados mínimos de uma reserva (previne spam)
      function isValidReservation() {
        let data = request.resource.data;
        return data.guestName is string && data.guestName.size() >= 2
            && data.guestPhone is string && data.guestPhone.size() >= 8
            && data.checkInDate is string && data.checkInDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.checkoutDate is string && data.checkoutDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.propertyId in ['lili', 'integracao'];
      }

      // Admin cria dentro do seu imóvel; a landing cria somente um pedido mínimo e pendente.
      allow create: if (isLoggedAdmin() && isValidReservation()
                         && hasPropertyAccess(request.resource.data.propertyId)
                         && hasValidCorporateLink(request.resource.data))
                    || isValidPublicBooking();

      // Atualizações administrativas aceitam reservas legadas sem telefone.
      // Sem propertyId, somente o super admin pode acessar e corrigir o documento.
      allow update: if isLoggedAdmin()
                    && hasReservationAccess(resource.data)
                    && hasReservationAccess(request.resource.data)
                    && (!('propertyId' in resource.data) || 'propertyId' in request.resource.data)
                    && hasValidCorporateLink(request.resource.data);

      // O guia usa /api/get-guest-config e a landing usa /api/get-availability.
      // Documentos completos de reserva nunca são públicos.
      allow list, get: if isLoggedAdmin()
                       && hasReservationAccess(resource.data);
      
      // DELETE: APENAS usuários autenticados com permissão
      allow delete: if isLoggedAdmin()
                    && hasReservationAccess(resource.data);
    }

    // 3. BLOQUEIOS DE DATA
    match /blocked_dates/{document} {
      allow read, write: if isLoggedAdmin();
    }
    
    // 4. USUÁRIOS ADMIN (Só Super Admin mexe)
    match /admin_users/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // 5. OUTRAS COLEÇÕES (Mantendo compatibilidade)
    match /tips/{document} { 
      allow read: if true; 
      allow write: if request.auth != null; 
    }
    match /places/{document} { 
      allow read: if true; 
      allow write: if request.auth != null; 
    }
    match /reviews/{document} { 
      allow read: if true; 
      allow write: if request.auth != null; 
    }

    // 6. CORPORATIVO B2B — módulo exclusivo do tenant Flats Integração.
    match /companies/{document} {
      allow read, write: if isLoggedAdmin() && hasPropertyAccess('integracao');
    }
    match /company_identifiers/{document} {
      allow read, write: if isLoggedAdmin() && hasPropertyAccess('integracao');
    }
    match /contracts/{document} {
      allow read: if isLoggedAdmin() && hasPropertyAccess('integracao');
      allow create: if isLoggedAdmin()
                    && hasPropertyAccess('integracao')
                    && request.resource.data.companyId is string
                    && existsAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId));
      allow update: if isLoggedAdmin()
                    && hasPropertyAccess('integracao')
                    && request.resource.data.companyId is string
                    && existsAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId));
    }
    match /allocations/{document} {
      allow read: if isLoggedAdmin()
                  && hasPropertyAccess(resource.data.propertyId);
      allow create: if isLoggedAdmin()
                    && hasPropertyAccess(request.resource.data.propertyId)
                    && request.resource.data.propertyId == 'integracao'
                    && existsAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId))
                    && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.companyId == request.resource.data.companyId;
      allow update: if isLoggedAdmin()
                    && hasPropertyAccess(resource.data.propertyId)
                    && hasPropertyAccess(request.resource.data.propertyId)
                    && request.resource.data.propertyId == 'integracao'
                    && exists(/databases/$(database)/documents/contracts/$(request.resource.data.contractId))
                    && get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.companyId == request.resource.data.companyId
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['guestName', 'guestPhone', 'notes', 'updatedAt'])
                      || (
                        request.resource.data.status == 'ended'
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'endDate', 'updatedAt'])
                      )
                    );
      allow delete: if isLoggedAdmin()
                    && hasPropertyAccess(resource.data.propertyId);
    }
    match /allocation_locks/{document} {
      allow read, write: if isLoggedAdmin() && hasPropertyAccess('integracao');
    }
    match /invoices/{document} {
      allow read, delete: if isLoggedAdmin() && hasPropertyAccess('integracao');
      allow create: if isLoggedAdmin()
                    && hasPropertyAccess('integracao')
                    && exists(/databases/$(database)/documents/contracts/$(request.resource.data.contractId))
                    && get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.companyId == request.resource.data.companyId;
      allow update: if isLoggedAdmin()
                    && hasPropertyAccess('integracao')
                    && exists(/databases/$(database)/documents/contracts/$(request.resource.data.contractId))
                    && get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.companyId == request.resource.data.companyId;
    }
    match /payments/{document} {
      allow read, delete: if isLoggedAdmin() && hasPropertyAccess('integracao');
      allow create: if isLoggedAdmin()
                    && hasPropertyAccess('integracao')
                    && request.resource.data.invoiceId is string
                    && exists(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId));
    }
    match /logs/{document} {
      allow read, write: if isLoggedAdmin();
    }
  }
}
